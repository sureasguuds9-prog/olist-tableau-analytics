      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='22'>Customer &amp; Retention | Клиенты и удержание</run>
          </formatted-text>
        </title>
      </layout-options>
      <style />
      <size sizing-mode='automatic' />
      <datasources>
        <datasource caption='olist_orders_dataset.csv+ (Multiple Connections)' name='federated.0z63i1q0upljid1ez2ag9110e76j' />
      </datasources>
      <datasource-dependencies datasource='federated.0z63i1q0upljid1ez2ag9110e76j'>
        <column caption='Order Month' datatype='datetime' default-format='*dd.MM.yyyy' name='[Calculation_4892926077497346]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[order_purchase_timestamp])' />
