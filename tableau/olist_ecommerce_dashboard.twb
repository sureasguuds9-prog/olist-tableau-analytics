      <aliases enabled='yes' />
      <column caption='Calculation1' datatype='real' name='[Calculation_4892926076604416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='' />
      </column>
      <column caption='Calculation2' datatype='real' name='[Calculation_4892926076739585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='' />
      </column>
      <column caption='Order Month' datatype='datetime' default-format='*dd.MM.yyyy' name='[Calculation_4892926077497346]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[order_purchase_timestamp])' />
      </column>
      <column caption='Item GMV' datatype='real' name='[Calculation_4892926077669379]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[price] + [freight_value]' />
      </column>
      <column caption='Category Clean' datatype='string' name='[Calculation_4892926087778308]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([product_category_name_english])&#10;OR TRIM([product_category_name_english]) = &apos;&apos;&#10;THEN &apos;Unknown&apos;&#10;ELSE [product_category_name_english]&#10;END' />
      </column>
      <column caption='Delay Days' datatype='integer' name='[Calculation_4892926290374661]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL([order_delivered_customer_date]) THEN&#10;    DATEDIFF(&#10;            &apos;day&apos;,&#10;[order_estimated_delivery_date],[order_delivered_customer_date])&#10;END' />
      </column>
      <column caption='Delivery Group' datatype='string' name='[Calculation_4892926290952198]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([order_delivered_customer_date]) THEN&#10;&apos;Not delivered&apos;&#10;ELSEIF [Calculation_4892926290374661] &gt; 0 THEN &#10;&apos;Late&apos;&#10;ELSE&#10;    &apos;On time or early&apos;&#10;END' />
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_4892926296006663]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4892926077669379]) / COUNTD([order_id])' />
      </column>
      <column caption='Customer First Order Date' datatype='datetime' name='[Calculation_4892926328778760]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [customer_unique_id] :&#10;    MIN([order_purchase_timestamp])&#10;}' />
      </column>
      <column caption='Customer Orders' datatype='integer' name='[Calculation_4892926328987657]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [customer_unique_id] :&#10;    COUNTD([order_id])&#10;}' />
      </column>
      <column caption='Customer Type' datatype='string' name='[Calculation_4892926329126922]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4892926328987657] &gt; 1 THEN&#10;    &quot;Повторный&quot;&#10;ELSE&#10;    &quot;Разовый&quot;&#10;END' />
      </column>
      <column caption='Repeat Customer' datatype='string' name='[Calculation_4892926329565195]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4892926328987657] &gt; 1 THEN&#10;    [customer_unique_id]&#10;END' />
      </column>
      <column caption='Repeat Rate' datatype='real' default-format='p0.00%' name='[Calculation_4892926329651212]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_4892926329565195])&#10;/&#10;COUNTD([customer_unique_id])' />
      </column>
      <column caption='Orders per Customer' datatype='real' name='[Calculation_4892926334304269]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])&#10;/&#10;COUNTD([customer_unique_id])' />
      </column>
      <column caption='Customer Lifecycle' datatype='string' name='[Calculation_4892926334955534]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;, [order_purchase_timestamp])&#10;    = DATETRUNC(&apos;month&apos;, [Calculation_4892926328778760])&#10;THEN&#10;    &quot;Новый&quot;&#10;ELSE&#10;    &quot;Повторный&quot;&#10;END' />
      </column>
      <column caption='Order Frequency Group' datatype='string' name='[Calculation_4892926335864847]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4892926328987657] = 1 THEN&#10;    &quot;1 заказ&quot;&#10;ELSEIF [Calculation_4892926328987657] = 2 THEN&#10;    &quot;2 заказа&quot;&#10;ELSE&#10;    &quot;3+ заказов&quot;&#10;END' />
      </column>
      <column caption='Cohort Month' datatype='datetime' name='[Calculation_4892926338572304]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [Calculation_4892926328778760])' />
      </column>
      <column aggregation='Sum' caption='Months Since First Order' datatype='integer' name='[Calculation_4892926338646033]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&#10;    &apos;month&apos;,&#10;    [Calculation_4892926328778760],&#10;    [order_purchase_timestamp]&#10;)' />
      </column>
      <column caption='Cohort Size' datatype='integer' name='[Calculation_4892926338957330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_4892926338572304] :&#10;    COUNTD([customer_unique_id])&#10;}' />
      </column>
      <column caption='Cohort Retention Rate' datatype='real' default-format='p0.0%' name='[Calculation_4892926339018771]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([customer_unique_id])&#10;/&#10;MIN([Calculation_4892926338957330])' />
      </column>
      <column caption='Data Max Order Date' datatype='datetime' name='[Calculation_4892926345080853]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED :&#10;    MAX([order_purchase_timestamp])&#10;}' />
      </column>
      <column caption='Customer Last Order Date' datatype='datetime' name='[Calculation_4892926345125910]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [customer_unique_id] :&#10;    MAX([order_purchase_timestamp])&#10;}' />
      </column>
      <column caption='Customer Recency Days' datatype='integer' name='[Calculation_4892926345224215]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&#10;    &apos;day&apos;,&#10;    [Calculation_4892926345125910],&#10;    [Calculation_4892926345080853]&#10;)' />
      </column>
      <column caption='Customer GMV' datatype='real' name='[Calculation_4892926345482264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [customer_unique_id] :&#10;    SUM([Calculation_4892926077669379])&#10;}' />
      </column>
      <column caption='RFM Segment' datatype='string' name='[Calculation_4892926345539609]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4892926328987657] &gt;= 3&#10;    AND [Calculation_4892926345224215] &lt;= 180&#10;THEN&#10;    &quot;Чемпионы&quot;&#10;&#10;ELSEIF [Calculation_4892926345482264] &gt;= 500&#10;    AND [Calculation_4892926345224215] &lt;= 365&#10;THEN&#10;    &quot;Ценные активные&quot;&#10;&#10;ELSEIF [Calculation_4892926328987657] &gt;= 2&#10;    AND [Calculation_4892926345224215] &lt;= 365&#10;THEN&#10;    &quot;Лояльные&quot;&#10;&#10;ELSEIF [Calculation_4892926328987657] = 1&#10;    AND [Calculation_4892926345224215] &lt;= 90&#10;THEN&#10;    &quot;Новые&quot;&#10;&#10;ELSEIF [Calculation_4892926328987657] &gt;= 2&#10;    AND [Calculation_4892926345224215] &gt; 365&#10;THEN&#10;    &quot;Под риском&quot;&#10;&#10;ELSE&#10;    &quot;Спящие&quot;&#10;END' />
      </column>
      <column caption='Category Top 10' datatype='string' name='[Calculation_4892926400000001]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_4892926087778308]' />
      </column>
      <column caption='On-Time Rate' datatype='real' default-format='p0.0%' name='[Calculation_6638676220485632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [Calculation_4892926290952198] = &quot;On time or early&quot;&#10;    THEN [order_id]&#10;    END&#10;)&#10;/&#10;COUNTD(&#10;    IF [Calculation_4892926290952198] = &quot;On time or early&quot;&#10;       OR [Calculation_4892926290952198] = &quot;Late&quot;&#10;    THEN [order_id]&#10;    END&#10;)' />
      </column>
      <column caption='Delivery Time Days' datatype='integer' name='[Calculation_6638676220968961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [order_status] = &quot;delivered&quot;&#10;   AND NOT ISNULL([order_delivered_customer_date])&#10;THEN&#10;    DATEDIFF(&#10;        &quot;day&quot;,&#10;        [order_purchase_timestamp],&#10;        [order_delivered_customer_date]&#10;    )&#10;END' />
      </column>
      <column caption='Late Order ID' datatype='string' name='[Calculation_6638676221849602]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4892926290952198] = &quot;Late&quot;&#10;THEN [order_id]&#10;END' />
      </column>
      <column caption='Late Delay Days' datatype='integer' name='[Calculation_6638676222255107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_4892926290374661] &gt; 0&#10;THEN [Calculation_4892926290374661]&#10;END' />
      </column>
      <column caption='Late Rate' datatype='real' default-format='p0.0%' name='[Calculation_6638676223283204]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [Calculation_4892926290952198] = &quot;Late&quot;&#10;    THEN [order_id]&#10;    END&#10;)&#10;/&#10;COUNTD(&#10;    IF [Calculation_4892926290952198] = &quot;Late&quot;&#10;       OR [Calculation_4892926290952198] = &quot;On time or early&quot;&#10;    THEN [order_id]&#10;    END&#10;)' />
      </column>
      <column caption='Delivered Order ID' datatype='string' name='[Calculation_6638676225019910]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4892926290952198] = &quot;Late&quot;&#10;   OR [Calculation_4892926290952198] = &quot;On time or early&quot;&#10;THEN [order_id]&#10;END' />
      </column>
      <column caption='Delay Bucket' datatype='string' name='[Calculation_6638676225798151]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_4892926290374661]) THEN&#10;    &quot;Не доставлен&quot;&#10;ELSEIF [Calculation_4892926290374661] &lt;= -7 THEN&#10;    &quot;Раньше на 7+ дней&quot;&#10;ELSEIF [Calculation_4892926290374661] &lt; 0 THEN&#10;    &quot;Раньше на 1–6 дней&quot;&#10;ELSEIF [Calculation_4892926290374661] = 0 THEN&#10;    &quot;В обещанный день&quot;&#10;ELSEIF [Calculation_4892926290374661] &lt;= 3 THEN&#10;    &quot;Опоздание 1–3 дня&quot;&#10;ELSEIF [Calculation_4892926290374661] &lt;= 7 THEN&#10;    &quot;Опоздание 4–7 дней&quot;&#10;ELSE&#10;    &quot;Опоздание 8+ дней&quot;&#10;END' />
      </column>
      <column caption='Delivery Time Days (bin)' datatype='integer' name='[Delivery Time Days (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[Calculation_6638676220968961]' peg='0' size='2' />
      </column>
