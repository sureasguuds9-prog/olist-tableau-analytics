    <worksheet name='KPI — AOV'>
      <table>
        <view>
          <datasources>
            <datasource caption='olist_orders_dataset.csv+ (Multiple Connections)' name='federated.0z63i1q0upljid1ez2ag9110e76j' />
          </datasources>
          <datasource-dependencies datasource='federated.0z63i1q0upljid1ez2ag9110e76j'>
            <column caption='Order Month' datatype='datetime' default-format='*dd.MM.yyyy' name='[Calculation_4892926077497346]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[order_purchase_timestamp])' />
            </column>
            <column caption='Item GMV' datatype='real' name='[Calculation_4892926077669379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[price] + [freight_value]' />
            </column>
            <column caption='Category Clean' datatype='string' name='[Calculation_4892926087778308]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([product_category_name_english])&#10;OR TRIM([product_category_name_english]) = &apos;&apos;&#10;THEN &apos;Unknown&apos;&#10;ELSE [product_category_name_english]&#10;END' />
            </column>
            <column caption='AOV' datatype='real' name='[Calculation_4892926296006663]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_4892926077669379]) / COUNTD([order_id])' />
            </column>
            <column caption='Customer Orders' datatype='integer' name='[Calculation_4892926328987657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [customer_unique_id] :&#10;    COUNTD([order_id])&#10;}' />
            </column>
            <column caption='Repeat Customer' datatype='string' name='[Calculation_4892926329565195]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_4892926328987657] &gt; 1 THEN&#10;    [customer_unique_id]&#10;END' />
            </column>
            <column caption='Repeat Rate' datatype='real' default-format='p0.00%' name='[Calculation_4892926329651212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_4892926329565195])&#10;/&#10;COUNTD([customer_unique_id])' />
            </column>
            <column caption='Customer State' datatype='string' name='[customer_state]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column caption='Customer Unique Id' datatype='string' name='[customer_unique_id]' role='dimension' type='nominal' />
            <column caption='Freight Value' datatype='real' name='[freight_value]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_4892926077497346]' derivation='None' name='[none:Calculation_4892926077497346:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4892926087778308]' derivation='None' name='[none:Calculation_4892926087778308:nk]' pivot='key' type='nominal' />
            <column-instance column='[customer_state]' derivation='None' name='[none:customer_state:nk]' pivot='key' type='nominal' />
            <column caption='Order Id' datatype='string' name='[order_id]' role='dimension' type='nominal' />
            <column caption='Order Purchase Timestamp' datatype='datetime' name='[order_purchase_timestamp]' role='dimension' type='ordinal' />
            <column caption='Price' datatype='real' name='[price]' role='measure' type='quantitative' />
            <column caption='Product Category Name English' datatype='string' name='[product_category_name_english]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_4892926296006663]' derivation='User' name='[usr:Calculation_4892926296006663:qk]' pivot='key' type='quantitative' />
