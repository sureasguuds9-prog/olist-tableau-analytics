              <calculation class='tableau' formula='IF NOT ISNULL([order_delivered_customer_date]) THEN&#10;    DATEDIFF(&#10;            &apos;day&apos;,&#10;[order_estimated_delivery_date],[order_delivered_customer_date])&#10;END' />
            </column>
            <column caption='Delivery Group' datatype='string' name='[Calculation_4892926290952198]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([order_delivered_customer_date]) THEN&#10;&apos;Not delivered&apos;&#10;ELSEIF [Calculation_4892926290374661] &gt; 0 THEN &#10;&apos;Late&apos;&#10;ELSE&#10;    &apos;On time or early&apos;&#10;END' />
            </column>
            <column caption='Customer Orders' datatype='integer' name='[Calculation_4892926328987657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [customer_unique_id] :&#10;    COUNTD([order_id])&#10;}' />
